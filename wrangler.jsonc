{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lawson-photography",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Non-secret Access config placeholders — replace with real values (or override in dashboard / .dev.vars).
	"vars": {
		"CF_ACCESS_TEAM_DOMAIN": "",
		"CF_ACCESS_AUD": ""
	},
	// D1 — create with `npx wrangler d1 create lawson-photography`, then replace database_id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lawson-photography",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "src/db/migrations"
		}
	],
	// Private R2 purpose buckets (bindings match HLD). Create buckets in the dashboard or via wrangler.
	"r2_buckets": [
		{
			"binding": "PORTFOLIO",
			"bucket_name": "lawson-portfolio"
		},
		{
			"binding": "REVIEW",
			"bucket_name": "lawson-review"
		}
	],
	// Images Free binding — compress-once at ingest (not hosted Images storage).
	"images": {
		"binding": "IMAGES"
	}
}
