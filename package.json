{
  "name": "lawson-photography",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "wrangler types && astro check",
    "typecheck": "wrangler types && astro check",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply photography --local",
    "test": "node --experimental-strip-types --test src/lib/cloudflare-env.test.ts src/lib/http/app-error.test.ts src/lib/ingest/keys.test.ts src/lib/media/parse-portfolio-media-path.test.ts",
    "r2:cors:apply": "wrangler r2 bucket cors set photography-portfolio --file infra/r2-cors/photography-portfolio.json -y && wrangler r2 bucket cors set photography-review --file infra/r2-cors/photography-review.json -y",
    "r2:cors:list": "wrangler r2 bucket cors list photography-portfolio && wrangler r2 bucket cors list photography-review",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.0.11",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.139.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
