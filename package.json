{
  "name": "lawson-photography",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "wrangler types && astro check",
    "typecheck": "wrangler types && astro check",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply photography --local",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' && vitest run && vitest run --config vitest.server.config.ts",
    "test:node": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:vitest": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "sentry:sourcemaps": "node scripts/sentry-worker-sourcemaps.mjs",
    "ci": "npm run lint && npm run format:check && npm test && npm run typecheck && npm run build && npx wrangler deploy --dry-run",
    "r2:cors:apply": "wrangler r2 bucket cors set photography-portfolio --file infra/r2-cors/photography-portfolio.json -y && wrangler r2 bucket cors set photography-review --file infra/r2-cors/photography-review.json -y",
    "r2:cors:list": "wrangler r2 bucket cors list photography-portfolio && wrangler r2 bucket cors list photography-review",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/cloudflare": "^10.75.3",
    "@sentry/react": "^10.75.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "jose": "^6.0.11",
    "photoswipe": "^5.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.139.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sentry/cli": "^2.58.4",
    "@sentry/vite-plugin": "^4.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
