---
import type { PublicReviewPhoto } from '../../lib/services/review-service.ts';

interface Props {
	slug: string;
	photos: PublicReviewPhoto[];
}

const { slug, photos } = Astro.props;
---

<section
	class="mx-auto px-4 py-10"
	style="max-width: 1200px"
	aria-label="Review gallery"
	data-review-gallery
	data-review-slug={slug}
>
	<p
		id="review-status"
		class="mb-4 hidden text-center text-sm"
		style="color: var(--color-accent)"
		role="status"
	></p>

	{
		photos.length === 0 ? (
			<p class="text-center text-sm" style="color: var(--color-fg-muted)">
				No photos are ready in this collection yet.
			</p>
		) : (
			<ul class="m-0 list-none columns-2 gap-3 p-0 sm:columns-3 lg:columns-4" data-gallery-grid>
				{photos.map((photo) => (
					<li
						data-gallery-item
						data-photo-id={photo.id}
						data-selection-status={photo.selectionStatus}
						data-gallery-url={photo.galleryUrl}
						data-gallery-width="1600"
						data-gallery-height="1200"
						class="mb-3 break-inside-avoid overflow-hidden border"
						style="border-color: var(--color-border); background: var(--color-bg-elevated)"
					>
						<button
							type="button"
							class="block w-full cursor-pointer border-0 p-0"
							style="background: transparent"
							data-gallery-open
							aria-label="View larger image"
						>
							<img
								src={photo.galleryUrl}
								alt=""
								width={1600}
								height={1200}
								loading="lazy"
								decoding="async"
								class="block h-auto w-full grayscale transition-[filter] duration-300 hover:grayscale-0"
							/>
						</button>
						<div class="flex flex-wrap gap-2 px-2 py-2 text-xs">
							<button
								type="button"
								class="border px-2 py-1 uppercase tracking-wide"
								style="border-color: var(--color-border); color: var(--color-fg)"
								data-review-select
								data-selection-status={photo.selectionStatus}
								aria-pressed={
									photo.selectionStatus === 'selected' || photo.selectionStatus === 'approved'
										? 'true'
										: 'false'
								}
							>
								{photo.selectionStatus === 'approved'
									? 'Approved'
									: photo.selectionStatus === 'selected'
										? 'Selected'
										: 'Select'}
							</button>
							<button
								type="button"
								class="border px-2 py-1 uppercase tracking-wide"
								style="border-color: var(--color-border); color: var(--color-fg-muted)"
								data-review-approve
							>
								{photo.selectionStatus === 'approved' ? 'Unapprove' : 'Approve'}
							</button>
						</div>
					</li>
				))}
			</ul>
		)
	}
</section>

<script>
	import { initReviewGallery } from '../../lib/client/review-gallery.ts';

	const root = document.querySelector('[data-review-gallery]');
	const statusEl = document.getElementById('review-status');
	if (root instanceof HTMLElement) {
		const slug = root.dataset.reviewSlug?.trim();
		if (slug) initReviewGallery(root, slug);
		root.addEventListener('review-selection-error', (event) => {
			if (!(event instanceof CustomEvent) || !statusEl) return;
			const message =
				typeof event.detail?.message === 'string' ? event.detail.message : 'Save failed';
			statusEl.textContent = message;
			statusEl.classList.remove('hidden');
		});
	}
</script>
