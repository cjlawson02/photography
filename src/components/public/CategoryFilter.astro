---
/** Static category chips — reference-only placeholder (live filters in PublicHomeGallery.tsx). */
const categories = ['All', 'Friends', 'Nature', 'Portraits', 'People', 'Beach'] as const;
const active = 'All';
---

<div class="public-wrap public-filters" style="padding-block: var(--space-3)" role="list">
	{
		categories.map((label) => (
			<button
				type="button"
				role="listitem"
				class="public-filter-btn"
				aria-pressed={label === active ? 'true' : 'false'}
				disabled
			>
				{label}
			</button>
		))
	}
</div>
