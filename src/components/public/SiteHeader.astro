---
/** Sticky header — Photograph theme branding + nav alignment (custom.css). */
---

<header class="public-header">
	<div class="public-header__inner">
		<a href="/" class="public-header__brand">
			<img
				src="/brand/logo-header.png"
				alt="Lawson Photography"
				width="220"
				height="35"
				class="public-header__logo"
				decoding="async"
			/>
		</a>
		<nav class="public-header__nav hidden sm:block" aria-label="Primary">
			<a href="/#gallery" class="public-header__nav-link">Portfolio</a>
		</nav>
	</div>
</header>
