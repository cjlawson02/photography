---
/** Sticky header shell — logo area + nav placeholder (Phase 3). */
---

<header
	class="sticky top-0 z-10 border-b"
	style="background: var(--color-bg-elevated); border-color: var(--color-border)"
>
	<div
		class="mx-auto flex items-center justify-between gap-4 px-4 py-3"
		style="max-width: 1200px"
	>
		<a
			href="/"
			class="text-2xl font-semibold tracking-wide no-underline"
			style="font-family: var(--font-display); color: var(--color-fg)"
		>
			Lawson Photography
		</a>
		<nav class="hidden text-sm sm:block" style="color: var(--color-fg-muted)" aria-label="Primary">
			<span>Portfolio</span>
		</nav>
	</div>
</header>
