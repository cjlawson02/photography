---
/** Hero carousel area — placeholder until portfolio hero flags + assets exist in D1/R2. */
---

<section
	class="relative flex min-h-[40vh] items-center justify-center px-4 py-16 text-center"
	style="background: var(--color-bg-elevated)"
	aria-label="Featured work"
>
	<div>
		<p
			class="text-3xl font-semibold sm:text-4xl"
			style="font-family: var(--font-display); color: var(--color-fg)"
		>
			Featured gallery
		</p>
		<p class="mt-3 text-sm sm:text-base" style="color: var(--color-fg-muted); max-width: 36rem; margin-inline: auto">
			Hero carousel placeholder — published photos will appear here after portfolio ingest.
		</p>
	</div>
</section>
