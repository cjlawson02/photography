---
import type { PublicPortfolioPhoto } from '../../lib/services/portfolio-service.ts';

interface Props {
	photos: PublicPortfolioPhoto[];
}

const { photos } = Astro.props;
const showNav = photos.length > 1;
---

{
	photos.length > 0 && (
		<section
			class="relative w-full overflow-hidden"
			style="background: var(--color-bg-elevated)"
			aria-label="Featured work"
			aria-roledescription="carousel"
			data-hero-carousel
			tabindex={showNav ? 0 : undefined}
		>
			<div class="relative mx-auto" style="max-width: 1400px">
				<div class="overflow-hidden" data-hero-viewport>
					<ul class="m-0 flex list-none touch-pan-y p-0" data-hero-container>
						{photos.map((photo, index) => (
							<li
								class="min-w-0 shrink-0 grow-0 basis-full"
								data-hero-slide
								aria-roledescription="slide"
								aria-label={`Slide ${index + 1} of ${photos.length}`}
							>
								<img
									src={photo.galleryUrl}
									alt=""
									width={1600}
									height={900}
									decoding="async"
									fetchpriority={index === 0 ? 'high' : 'auto'}
									class="block max-h-[min(70vh,720px)] w-full object-cover"
								/>
							</li>
						))}
					</ul>
				</div>

				{showNav && (
					<>
						<button
							type="button"
							class="absolute top-1/2 left-2 z-10 -translate-y-1/2 border px-3 py-2 text-sm uppercase tracking-wide"
							style="border-color: var(--color-border); color: var(--color-fg); background: rgba(43, 43, 43, 0.75)"
							data-hero-prev
							aria-label="Previous featured photo"
						>
							Prev
						</button>
						<button
							type="button"
							class="absolute top-1/2 right-2 z-10 -translate-y-1/2 border px-3 py-2 text-sm uppercase tracking-wide"
							style="border-color: var(--color-border); color: var(--color-fg); background: rgba(43, 43, 43, 0.75)"
							data-hero-next
							aria-label="Next featured photo"
						>
							Next
						</button>
						<p
							class="absolute bottom-3 left-1/2 z-10 -translate-x-1/2 text-xs uppercase tracking-widest"
							style="color: var(--color-fg-muted)"
							data-hero-indicator
							aria-live="polite"
						>
							1 / {photos.length}
						</p>
					</>
				)}
			</div>
		</section>
	)
}

<script>
	import { initHeroCarousel } from '../../lib/client/hero-carousel.ts';

	document.querySelectorAll('[data-hero-carousel]').forEach((root) => {
		if (root instanceof HTMLElement) initHeroCarousel(root);
	});
</script>
