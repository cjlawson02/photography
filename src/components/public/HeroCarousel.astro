---
import type { PublicPortfolioPhoto } from '../../lib/services/portfolio-service.ts';

interface Props {
	photos: PublicPortfolioPhoto[];
}

const { photos } = Astro.props;
const showNav = photos.length > 1;
---

{
	photos.length > 0 && (
		<section
			class="relative w-full overflow-hidden"
			style="background: var(--color-bg-elevated)"
			aria-label="Featured work"
			data-hero-carousel
		>
			<div class="relative mx-auto" style="max-width: 1400px">
				<ul class="m-0 flex list-none p-0" data-hero-track>
					{photos.map((photo, index) => (
						<li
							class="min-w-full shrink-0"
							data-hero-slide
							hidden={index !== 0}
							aria-hidden={index !== 0 ? 'true' : 'false'}
						>
							<img
								src={photo.galleryUrl}
								alt=""
								width={1600}
								height={900}
								decoding="async"
								fetchpriority={index === 0 ? 'high' : 'auto'}
								class="block max-h-[min(70vh,720px)] w-full object-cover"
							/>
						</li>
					))}
				</ul>

				{showNav && (
					<>
						<button
							type="button"
							class="absolute top-1/2 left-2 -translate-y-1/2 border px-3 py-2 text-sm uppercase tracking-wide"
							style="border-color: var(--color-border); color: var(--color-fg); background: rgba(43, 43, 43, 0.75)"
							data-hero-prev
							aria-label="Previous featured photo"
						>
							Prev
						</button>
						<button
							type="button"
							class="absolute top-1/2 right-2 -translate-y-1/2 border px-3 py-2 text-sm uppercase tracking-wide"
							style="border-color: var(--color-border); color: var(--color-fg); background: rgba(43, 43, 43, 0.75)"
							data-hero-next
							aria-label="Next featured photo"
						>
							Next
						</button>
						<p
							class="absolute bottom-3 left-1/2 -translate-x-1/2 text-xs uppercase tracking-widest"
							style="color: var(--color-fg-muted)"
							data-hero-indicator
							aria-live="polite"
						>
							1 / {photos.length}
						</p>
					</>
				)}
			</div>
		</section>
	)
}

<script>
	function initHeroCarousel(root: HTMLElement) {
		const slides = [...root.querySelectorAll('[data-hero-slide]')];
		if (slides.length <= 1) return;

		let index = 0;

		const indicator = root.querySelector('[data-hero-indicator]');
		const prev = root.querySelector('[data-hero-prev]');
		const next = root.querySelector('[data-hero-next]');

		function show(nextIndex: number) {
			index = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				if (!(slide instanceof HTMLElement)) return;
				const active = i === index;
				slide.hidden = !active;
				slide.setAttribute('aria-hidden', active ? 'false' : 'true');
			});
			if (indicator) {
				indicator.textContent = `${index + 1} / ${slides.length}`;
			}
		}

		prev?.addEventListener('click', () => show(index - 1));
		next?.addEventListener('click', () => show(index + 1));

		root.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				show(index - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				show(index + 1);
			}
		});
	}

	document.querySelectorAll('[data-hero-carousel]').forEach((root) => {
		if (root instanceof HTMLElement) initHeroCarousel(root);
	});
</script>
