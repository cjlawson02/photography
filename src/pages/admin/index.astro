---
import AdminLayout from '../../layouts/AdminLayout.astro';

/** Admin dashboard — links into portfolio and review sections. */
---

<AdminLayout title="Admin — Dashboard" current="dashboard">
	<h1 class="text-2xl" style="font-family: var(--font-display); color: var(--color-fg)">Dashboard</h1>
	<p class="mt-2 text-sm" style="color: var(--color-fg-muted); max-width: var(--measure)">
		Access-gated admin shell (Phase 2). Portfolio publish flows and public gallery remain later phases.
	</p>

	<ul class="mt-8 space-y-3 text-sm" style="color: var(--color-fg)">
		<li>
			<a href="/admin/portfolio" style="color: var(--color-accent)">Portfolio</a>
			<span style="color: var(--color-fg-muted)"> — catalog and publish (_TBD_)</span>
		</li>
		<li>
			<a href="/admin/review" style="color: var(--color-accent)">Review collections</a>
			<span style="color: var(--color-fg-muted)"> — create links for client proofing</span>
		</li>
	</ul>

	<p class="mt-10 text-xs" style="color: var(--color-fg-muted)">
		API smoke:
		<a style="color: var(--color-accent)" href="/admin/api/health">/admin/api/health</a>
	</p>
</AdminLayout>
