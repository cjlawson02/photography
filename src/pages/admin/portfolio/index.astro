---
import { env } from 'cloudflare:workers';

import PortfolioAdminTable from '../../../components/admin/PortfolioAdminTable.tsx';
import {
	loadPortfolioAdminFirstPage,
	scheduleStalePendingCleanupAfterAdminListLoad,
} from '../../../lib/admin/ssr-initial-reads.ts';
import { AppEnv } from '../../../lib/env.ts';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const app = AppEnv.fromBindings(env);
const waitUntil = Astro.locals.cfContext?.waitUntil.bind(Astro.locals.cfContext);
const initialPortfolioPage = await loadPortfolioAdminFirstPage(app);
scheduleStalePendingCleanupAfterAdminListLoad(app, waitUntil);
---

<AdminLayout title="Admin — Portfolio" current="portfolio">
	<h1 class="text-2xl" style="font-family: var(--font-display); color: var(--color-fg)">Portfolio</h1>
	<p class="mt-2 text-sm" style="color: var(--color-fg-muted); max-width: var(--measure)">
		Publish ready photos to the public home grid. Upload new originals with the form below the
		heading.
	</p>

	<PortfolioAdminTable client:load initialPortfolioPage={initialPortfolioPage} />

	<p class="mt-6 text-xs" style="color: var(--color-fg-muted)">
		API: <code>/admin/api/trpc</code> (<code>portfolio.list</code>, <code>portfolio.update</code>,
		<code>portfolio.delete</code>)
	</p>
</AdminLayout>
