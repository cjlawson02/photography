---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PORTFOLIO_CATEGORIES } from '../../../lib/portfolio/categories.ts';
---

<AdminLayout title="Admin — Portfolio" current="portfolio">
	<h1 class="text-2xl" style="font-family: var(--font-display); color: var(--color-fg)">Portfolio</h1>
	<p class="mt-2 text-sm" style="color: var(--color-fg-muted); max-width: var(--measure)">
		Publish ready photos to the public home grid. Upload new originals via{' '}
		<a href="/admin/ingest" style="color: var(--color-accent)">Upload</a>.
	</p>

	<p
		id="portfolio-status"
		class="mt-4 text-xs"
		style="color: var(--color-fg-muted)"
		aria-live="polite"
	>
		Loading…
	</p>

	<div class="mt-6 overflow-x-auto">
		<table class="w-full text-left text-sm" style="color: var(--color-fg)">
			<thead>
				<tr style="color: var(--color-fg-muted); border-bottom: 1px solid var(--color-border)">
					<th class="py-2 pr-4 font-normal">Preview</th>
					<th class="py-2 pr-4 font-normal">Ingest</th>
					<th class="py-2 pr-4 font-normal">Published</th>
					<th class="py-2 pr-4 font-normal">Category</th>
					<th class="py-2 pr-4 font-normal">Sort</th>
					<th class="py-2 pr-4 font-normal">Hero</th>
					<th class="py-2 pr-4 font-normal">Updated</th>
					<th class="py-2 font-normal">Actions</th>
				</tr>
			</thead>
			<tbody id="portfolio-rows"></tbody>
		</table>
	</div>

	<p class="mt-6 text-xs" style="color: var(--color-fg-muted)">
		API: <code>GET/PATCH/DELETE /admin/api/portfolio/photos</code>
	</p>
</AdminLayout>

<script define:vars={{ categories: [...PORTFOLIO_CATEGORIES] }}>
	import { requestReprocess } from '../../../lib/ingest/browser-upload.ts';

	const statusEl = document.getElementById('portfolio-status');
	const tbody = document.getElementById('portfolio-rows');

	function formatTime(ms) {
		if (!ms) return '—';
		return new Date(ms).toLocaleString();
	}

	async function patchPhoto(id, body) {
		const res = await fetch(`/admin/api/portfolio/photos/${id}`, {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		const json = await res.json();
		if (!res.ok || !json.ok) {
			throw new Error(json.error ?? `Update failed (${res.status})`);
		}
		return json.photo;
	}

	async function deletePhoto(id) {
		const res = await fetch(`/admin/api/portfolio/photos/${id}`, { method: 'DELETE' });
		const json = await res.json();
		if (!res.ok || !json.ok) {
			throw new Error(json.error ?? `Delete failed (${res.status})`);
		}
	}

	function renderRow(photo) {
		const tr = document.createElement('tr');
		tr.style.borderBottom = '1px solid var(--color-border)';
		tr.dataset.photoId = photo.id;

		const thumbUrl =
			photo.status === 'ready'
				? `/media/portfolio/${photo.id}/thumb.webp`
				: '';

		tr.innerHTML = `
			<td class="py-3 pr-4 align-middle">
				${
					thumbUrl
						? `<img src="${thumbUrl}" alt="" width="72" height="54" class="border object-cover" style="border-color: var(--color-border); width: 4.5rem; height: 3.375rem;" />`
						: '<span class="text-xs" style="color: var(--color-fg-muted)">—</span>'
				}
			</td>
			<td class="py-3 pr-4 align-middle"><code class="text-xs">${photo.status}</code></td>
			<td class="py-3 pr-4 align-middle">
				<label class="inline-flex items-center gap-2 text-xs">
					<input type="checkbox" data-field="published" ${photo.published ? 'checked' : ''} ${
						photo.status !== 'ready' ? 'disabled title="Ingest must be ready"' : ''
					} />
					<span>${photo.published ? 'Yes' : 'No'}</span>
				</label>
			</td>
			<td class="py-3 pr-4 align-middle">
				<select data-field="category" class="border px-2 py-1 text-xs" style="border-color: var(--color-border); background: var(--color-bg); color: var(--color-fg)">
					<option value="">—</option>
					${categories
						.map(
							(c) =>
								`<option value="${c}" ${photo.category === c ? 'selected' : ''}>${c}</option>`,
						)
						.join('')}
				</select>
			</td>
			<td class="py-3 pr-4 align-middle">
				<input
					data-field="sortOrder"
					type="number"
					class="w-20 border px-2 py-1 text-xs"
					style="border-color: var(--color-border); background: var(--color-bg); color: var(--color-fg)"
					value="${photo.sortOrder ?? ''}"
					placeholder="—"
				/>
			</td>
			<td class="py-3 pr-4 align-middle">
				<label class="inline-flex items-center gap-2 text-xs">
					<input type="checkbox" data-field="hero" ${photo.hero ? 'checked' : ''} />
					<span>${photo.hero ? 'Yes' : 'No'}</span>
				</label>
			</td>
			<td class="py-3 pr-4 align-middle text-xs" style="color: var(--color-fg-muted)">${formatTime(
				photo.updatedAt,
			)}</td>
			<td class="py-3 align-middle">
				<div class="flex flex-wrap gap-2">
					${
						photo.status === 'failed' || photo.status === 'pending'
							? `<button type="button" data-action="reprocess" class="text-xs underline" style="color: var(--color-fg)">Reprocess</button>`
							: ''
					}
					<button type="button" data-action="delete" class="text-xs underline" style="color: var(--color-accent)">
						Delete
					</button>
				</div>
			</td>
		`;

		const publishedInput = tr.querySelector('[data-field="published"]');
		publishedInput?.addEventListener('change', async () => {
			if (!(publishedInput instanceof HTMLInputElement)) return;
			statusEl.textContent = 'Saving publish…';
			try {
				await patchPhoto(photo.id, { published: publishedInput.checked });
				statusEl.textContent = 'Saved.';
				await loadPhotos();
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
				publishedInput.checked = !publishedInput.checked;
			}
		});

		const categorySelect = tr.querySelector('[data-field="category"]');
		categorySelect?.addEventListener('change', async () => {
			if (!(categorySelect instanceof HTMLSelectElement)) return;
			const value = categorySelect.value;
			statusEl.textContent = 'Saving category…';
			try {
				await patchPhoto(photo.id, { category: value === '' ? null : value });
				statusEl.textContent = 'Saved.';
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
			}
		});

		const sortInput = tr.querySelector('[data-field="sortOrder"]');
		sortInput?.addEventListener('change', async () => {
			if (!(sortInput instanceof HTMLInputElement)) return;
			const raw = sortInput.value.trim();
			const sortOrder = raw === '' ? null : Number.parseInt(raw, 10);
			if (raw !== '' && Number.isNaN(sortOrder)) {
				statusEl.textContent = 'Sort must be a number.';
				return;
			}
			statusEl.textContent = 'Saving sort…';
			try {
				await patchPhoto(photo.id, { sortOrder });
				statusEl.textContent = 'Saved.';
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
			}
		});

		const heroInput = tr.querySelector('[data-field="hero"]');
		heroInput?.addEventListener('change', async () => {
			if (!(heroInput instanceof HTMLInputElement)) return;
			statusEl.textContent = 'Saving hero…';
			try {
				await patchPhoto(photo.id, { hero: heroInput.checked });
				statusEl.textContent = 'Saved.';
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
				heroInput.checked = !heroInput.checked;
			}
		});

		const reprocessBtn = tr.querySelector('[data-action="reprocess"]');
		reprocessBtn?.addEventListener('click', async () => {
			statusEl.textContent = 'Reprocessing from original…';
			try {
				await requestReprocess({ id: photo.id, bucket: 'portfolio' });
				statusEl.textContent = 'Reprocess complete.';
				await loadPhotos();
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
			}
		});

		const deleteBtn = tr.querySelector('[data-action="delete"]');
		deleteBtn?.addEventListener('click', async () => {
			if (!confirm(`Delete portfolio photo ${photo.id}?`)) return;
			statusEl.textContent = 'Deleting…';
			try {
				await deletePhoto(photo.id);
				statusEl.textContent = 'Deleted.';
				tr.remove();
			} catch (error) {
				statusEl.textContent = error instanceof Error ? error.message : String(error);
			}
		});

		return tr;
	}

	async function loadPhotos() {
		if (!tbody || !statusEl) return;
		statusEl.textContent = 'Loading…';
		tbody.replaceChildren();
		const res = await fetch('/admin/api/portfolio/photos');
		const json = await res.json();
		if (!res.ok || !json.ok) {
			statusEl.textContent = json.error ?? `Load failed (${res.status})`;
			return;
		}
		const photos = json.photos ?? [];
		if (photos.length === 0) {
			statusEl.textContent = 'No portfolio photos yet — upload via Upload.';
			return;
		}
		for (const photo of photos) {
			tbody.append(renderRow(photo));
		}
		statusEl.textContent = `${photos.length} photo(s).`;
	}

	loadPhotos();
</script>
