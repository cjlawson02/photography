	/>

	<ul class="mt-8 space-y-3 text-sm admin-fg">
		<li>
			<a class="admin-link" href="/admin/portfolio/front-page">Front page</a>
			<span class="admin-fg-muted"> — ordered set + hero</span>
		</li>
		<li>
			<a class="admin-link" href="/admin/portfolio/library">Library</a>
			<span class="admin-fg-muted"> — grid + inspector</span>
		</li>
	</ul>
</AdminLayout>
