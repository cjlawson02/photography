---
import { env } from 'cloudflare:workers';

import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import ReviewCollectionsAdmin from '../../../components/admin/ReviewCollectionsAdmin.tsx';
import {
	loadReviewCollectionsList,
	scheduleStalePendingCleanupAfterAdminListLoad,
} from '../../../lib/admin/ssr-initial-reads.ts';
import { AppEnv } from '../../../lib/env.ts';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const app = AppEnv.fromBindings(env);
const waitUntil = Astro.locals.cfContext?.waitUntil.bind(Astro.locals.cfContext);
const initialCollections = await loadReviewCollectionsList(app);
scheduleStalePendingCleanupAfterAdminListLoad(app, waitUntil);
---

<AdminLayout title="Admin — Review" current="review">
	<AdminPageHeader
		title="Review collections"
		lede="Proofing sets addressed by slug. Share the client link below; selections save on the public review page. Use collection ids for REVIEW ingest."
	/>

	<ReviewCollectionsAdmin client:load initialCollections={initialCollections} />
</AdminLayout>
