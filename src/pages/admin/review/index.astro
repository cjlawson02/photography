---
import AdminLayout from '../../../layouts/AdminLayout.astro';

/** Review collection management — create/list for ingest `collectionId`; public pages Phase 4. */
---

<AdminLayout title="Admin — Review" current="review">
	<h1 class="text-2xl" style="font-family: var(--font-display); color: var(--color-fg)">
		Review collections
	</h1>
	<p class="mt-2 text-sm" style="color: var(--color-fg-muted); max-width: var(--measure)">
		Proofing sets addressed by slug. Shareable <code>/review/&#123;slug&#125;</code> pages and client
		selections land in Phase 4; here you can create collections and use their ids for REVIEW ingest.
	</p>

	<section class="mt-8">
		<h2 class="text-sm font-medium uppercase tracking-wide" style="color: var(--color-fg-muted)">
			New collection
		</h2>
		<form id="create-collection" class="mt-3 grid gap-3 sm:grid-cols-2">
			<label class="block text-sm sm:col-span-2" style="color: var(--color-fg)">
				Slug (URL segment)
				<input
					type="text"
					name="slug"
					required
					pattern="[^\s]+"
					placeholder="smith-wedding-2026"
					class="mt-1 block w-full border px-3 py-2 text-sm"
					style="border-color: var(--color-border); background: var(--color-bg); color: var(--color-fg)"
					autocomplete="off"
				/>
			</label>
			<label class="block text-sm" style="color: var(--color-fg)">
				Title (optional)
				<input
					type="text"
					name="title"
					class="mt-1 block w-full border px-3 py-2 text-sm"
					style="border-color: var(--color-border); background: var(--color-bg); color: var(--color-fg)"
				/>
			</label>
			<label class="block text-sm" style="color: var(--color-fg)">
				Expires (optional)
				<input
					type="datetime-local"
					name="expiresAt"
					class="mt-1 block w-full border px-3 py-2 text-sm"
					style="border-color: var(--color-border); background: var(--color-bg); color: var(--color-fg)"
				/>
			</label>
			<div class="sm:col-span-2">
				<button
					type="submit"
					class="px-4 py-2 text-sm"
					style="background: var(--color-accent); color: var(--color-bg)"
				>
					Create collection
				</button>
			</div>
		</form>
		<p
			id="create-status"
			class="mt-3 text-xs"
			style="color: var(--color-fg-muted)"
			aria-live="polite"
		></p>
	</section>

	<section class="mt-10">
		<h2 class="text-sm font-medium uppercase tracking-wide" style="color: var(--color-fg-muted)">
			Collections
		</h2>
		<div class="mt-3 overflow-x-auto">
			<table class="w-full text-left text-sm" style="color: var(--color-fg)">
				<thead>
					<tr style="color: var(--color-fg-muted); border-bottom: 1px solid var(--color-border)">
						<th class="py-2 pr-4 font-normal">Slug</th>
						<th class="py-2 pr-4 font-normal">Title</th>
						<th class="py-2 pr-4 font-normal">Expires</th>
						<th class="py-2 font-normal">Id</th>
					</tr>
				</thead>
				<tbody id="collections-body">
					<tr>
						<td colspan="4" class="py-4 text-xs" style="color: var(--color-fg-muted)">Loading…</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
</AdminLayout>

<script>
	type CollectionRow = {
		id: string;
		slug: string;
		title: string | null;
		expiresAt: number | null;
		createdAt: number;
	};

	const tbody = document.getElementById('collections-body');
	const createForm = document.getElementById('create-collection');
	const createStatus = document.getElementById('create-status');

	function formatExpires(ms: number | null): string {
		if (ms == null) return '—';
		return new Date(ms).toLocaleString();
	}

	function renderRows(rows: CollectionRow[]) {
		if (!tbody) return;
		if (rows.length === 0) {
			tbody.innerHTML =
				'<tr><td colspan="4" class="py-4 text-xs" style="color: var(--color-fg-muted)">No collections yet.</td></tr>';
			return;
		}
		tbody.innerHTML = rows
			.map(
				(row) => `<tr style="border-bottom: 1px solid var(--color-border)">
			<td class="py-2 pr-4">${escapeHtml(row.slug)}</td>
			<td class="py-2 pr-4">${escapeHtml(row.title ?? '—')}</td>
			<td class="py-2 pr-4 text-xs">${escapeHtml(formatExpires(row.expiresAt))}</td>
			<td class="py-2 font-mono text-xs" style="color: var(--color-fg-muted)">${escapeHtml(row.id)}</td>
		</tr>`,
			)
			.join('');
	}

	function escapeHtml(value: string): string {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;');
	}

	async function loadCollections() {
		try {
			const res = await fetch('/admin/api/review/collections');
			const json = (await res.json()) as {
				ok?: boolean;
				collections?: CollectionRow[];
				error?: string;
			};
			if (!res.ok || !json.ok || !json.collections) {
				if (tbody) {
					tbody.innerHTML = `<tr><td colspan="4" class="py-4 text-xs" style="color: var(--color-fg-muted)">${escapeHtml(json.error ?? 'Failed to load')}</td></tr>`;
				}
				return;
			}
			renderRows(json.collections);
		} catch {
			if (tbody) {
				tbody.innerHTML =
					'<tr><td colspan="4" class="py-4 text-xs" style="color: var(--color-fg-muted)">Failed to load</td></tr>';
			}
		}
	}

	createForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!(createForm instanceof HTMLFormElement) || !createStatus) return;

		const data = new FormData(createForm);
		const slug = String(data.get('slug') ?? '').trim();
		const titleRaw = String(data.get('title') ?? '').trim();
		const expiresRaw = String(data.get('expiresAt') ?? '').trim();

		if (!slug) {
			createStatus.textContent = 'Slug is required.';
			return;
		}

		const payload: { slug: string; title?: string; expiresAt?: number } = { slug };
		if (titleRaw) payload.title = titleRaw;
		if (expiresRaw) {
			const ms = new Date(expiresRaw).getTime();
			if (Number.isNaN(ms)) {
				createStatus.textContent = 'Invalid expiry date.';
				return;
			}
			payload.expiresAt = ms;
		}

		createStatus.textContent = 'Creating…';
		try {
			const res = await fetch('/admin/api/review/collections', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const json = (await res.json()) as { ok?: boolean; error?: string };
			if (!res.ok || !json.ok) {
				createStatus.textContent = json.error ?? 'Create failed';
				return;
			}
			createStatus.textContent = 'Created.';
			createForm.reset();
			await loadCollections();
		} catch {
			createStatus.textContent = 'Create failed';
		}
	});

	void loadCollections();
</script>
