---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lawson Photography">
	<main class="mx-auto px-4 py-10" style="max-width: var(--measure)">
		<p class="text-4xl tracking-tight" style="font-family: var(--font-display); color: var(--color-fg)">
			Lawson Photography
		</p>
		<p class="mt-3" style="color: var(--color-fg-muted); max-width: var(--measure)">
			Phase 0 foundation scaffold — Workers + Astro hybrid SSR. Public portfolio UI comes later.
		</p>
		<p class="mt-6 text-sm" style="color: var(--color-fg-muted)">
			Health:
			<a style="color: var(--color-accent); text-decoration: underline" href="/health">/health</a>
		</p>
	</main>
</BaseLayout>
