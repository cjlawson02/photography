---
import { env } from 'cloudflare:workers';

import HeroCarousel from '../components/public/HeroCarousel.tsx';
import PublicHomeGallery from '../components/public/PublicHomeGallery.tsx';
import PublicIntro from '../components/public/PublicIntro.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { selectHeroPhotos } from '../lib/portfolio/hero-photos.ts';
import { canonicalUrl, DEFAULT_SITE_DESCRIPTION, SITE_NAME } from '../lib/site/public-meta.ts';
import {
	listFrontPagePortfolioPhotos,
	listPublishedPortfolioPhotos,
} from '../lib/services/portfolio-service.ts';

const [photos, featured] = await Promise.all([
	listPublishedPortfolioPhotos(env.DB),
	listFrontPagePortfolioPhotos(env.DB),
]);
// Heroes live on the Featured set once curated; before that, any published hero still works.
const heroPhotos = selectHeroPhotos(featured.length > 0 ? featured : photos);
const ogImage =
	heroPhotos[0]?.galleryUrl != null
		? canonicalUrl(heroPhotos[0].galleryUrl)
		: undefined;
---

<PublicLayout
	title={SITE_NAME}
	description={DEFAULT_SITE_DESCRIPTION}
	canonical={canonicalUrl('/')}
	ogImage={ogImage}
	overlayHeader={heroPhotos.length > 0}
>
	<HeroCarousel client:load photos={heroPhotos} />
	<PublicIntro />
	<PublicHomeGallery client:visible photos={photos} featured={featured} />
</PublicLayout>
