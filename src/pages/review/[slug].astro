---
import { env } from 'cloudflare:workers';

import ReviewDownloadGallery from '../../components/public/ReviewDownloadGallery.tsx';
import ReviewGallery from '../../components/public/ReviewGallery.tsx';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { resolveReviewPageState } from '../../lib/services/review-service.ts';

const slug = Astro.params.slug?.trim() ?? '';
const state = slug ? await resolveReviewPageState(env.DB, slug) : { kind: 'not_found' as const };

if (state.kind === 'not_found') {
	Astro.response.status = 404;
}

const pageTitle =
	state.kind === 'ok'
		? state.collection.title?.trim() || 'Client review'
		: state.kind === 'gallery_closed'
			? 'Gallery closed'
			: 'Client review';

const pageDescription =
	state.kind === 'ok'
		? state.collection.mode === 'download'
			? `Download your edited photos for ${pageTitle}.`
			: `Review and select photos for ${pageTitle}. Choices save automatically.`
		: state.kind === 'gallery_closed'
			? 'This gallery has closed.'
			: 'This client review link could not be found.';
---

{
	state.kind === 'not_found' ? (
		<ReviewLayout title="Review not found" description={pageDescription}>
			<main class="public-wrap text-center" style="padding-block: var(--space-5) var(--space-4)">
				<h1 class="public-section-title">Review not found</h1>
				<p class="mt-6 text-sm" style="color: var(--color-fg-muted)">
					This link may be incorrect or has been revoked.
				</p>
			</main>
		</ReviewLayout>
	) : state.kind === 'gallery_closed' ? (
		<ReviewLayout title={pageTitle} description={pageDescription}>
			<main class="public-wrap text-center" style="padding-block: var(--space-5) var(--space-4)">
				<h1 class="public-section-title">This gallery has closed</h1>
				{state.title ? (
					<p class="mt-3 text-sm" style="color: var(--color-fg-muted)">{state.title}</p>
				) : null}
				<p class="mt-6 text-sm" style="color: var(--color-fg-muted)">
					Contact Lawson Photography if you need help.
				</p>
			</main>
		</ReviewLayout>
	) : state.kind === 'ok' ? (
		<ReviewLayout title={pageTitle} description={pageDescription}>
			<main>
				<header class="public-wrap text-center" style="padding-top: var(--space-5)">
					<h1 class="public-section-title">
						{state.collection.title?.trim() || 'Client review'}
					</h1>
					<p class="mt-3 text-sm" style="color: var(--color-fg-muted)">
						{state.collection.mode === 'download'
							? 'Download each full-resolution file below.'
							: 'Select your favorites, then submit when you are done. Your choices save automatically.'}
					</p>
				</header>
				{state.collection.mode === 'download' ? (
					<ReviewDownloadGallery client:load photos={state.collection.downloadPhotos} />
				) : (
					<ReviewGallery
						client:load
						slug={state.collection.slug}
						photos={state.collection.photos}
						picksLocked={state.collection.picksLocked}
					/>
				)}
			</main>
		</ReviewLayout>
	) : null
}
