---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonical={canonical}>
	<SiteHeader />
	<slot />
	<footer class="public-footer">
		<p class="m-0 text-xs" style="line-height: 1.666">&copy; {new Date().getFullYear()} Lawson Photography</p>
	</footer>
</BaseLayout>
