---
import BaseLayout from './BaseLayout.astro';
import ApertureMark from '../components/public/ApertureMark.tsx';
import SiteHeader from '../components/public/SiteHeader.tsx';
import { SITE_NAME } from '../lib/site/public-meta.ts';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
	/** Header floats transparently over a full-bleed hero. */
	overlayHeader?: boolean;
}

const { title, description, ogImage, canonical, overlayHeader = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonical={canonical}>
	<div class="public-grain" aria-hidden="true"></div>
	<SiteHeader client:load overlay={overlayHeader} />
	<slot />
	<footer class="public-footer">
		<div class="public-footer__inner">
			<p class="public-footer__brand">
				<ApertureMark className="public-footer__mark" />
				<span>&copy; {new Date().getFullYear()} {SITE_NAME}</span>
			</p>
			<a href="#top" class="public-footer__link">Back to top <span aria-hidden="true">↑</span></a>
		</div>
	</footer>
</BaseLayout>
