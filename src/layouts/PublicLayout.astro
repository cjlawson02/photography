---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonical={canonical}>
	<SiteHeader />
	<slot />
	<footer
		class="mt-auto px-4 py-6 text-center text-sm"
		style="background: var(--color-bg-elevated); color: var(--color-fg-muted)"
	>
		&copy; {new Date().getFullYear()} Lawson Photography
	</footer>
</BaseLayout>
