---
import '../styles/global.css';

interface Props {
	title?: string;
	/** When set, emitted as `<meta name="robots" …>` (e.g. review surfaces). */
	robots?: string;
}

const { title = 'Lawson Photography', robots } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		{robots ? <meta name="robots" content={robots} /> : null}
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Roboto+Condensed:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-dvh">
		<div class="flex min-h-dvh flex-col" style="background: var(--color-bg); color: var(--color-fg)">
			<slot />
		</div>
	</body>
</html>
