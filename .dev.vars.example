# Local Worker secrets / vars — copy to `.dev.vars` and fill in.
# Never commit real values.
# Production Access: plain vars in wrangler.jsonc. Production R2: `npx wrangler secret put <NAME>`.

# Production host: https://photography.chrislawson.dev (admin at /admin*)

# Cloudflare Access (admin JWT verification on /admin/api/*)
# Zero Trust → Access → Public DNS app on photography.chrislawson.dev path /admin*
CF_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=

# R2 S3 API credentials for browser presigned PUT (not provided by R2 bindings alone)
# Required for AppEnv / ingest routes (fail-fast 503 if empty). /health does not need these.
# R2 → Overview → Account details → API Tokens → Object Read & Write on photography-portfolio + photography-review.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional Worker error monitoring (@sentry/cloudflare — no-op when empty)
# SENTRY_DSN=
# SENTRY_RELEASE=

# --- Legacy WP migration (T7) — prefer untracked `.legacy-export/.env` for secrets ---
# WP_DB_HOST=172.16.1.2
# WP_DB_PORT=3306
# WP_DB_NAME=lawsonphotography
# WP_DB_USER=lawsonphotography
# WP_DB_PASSWORD=
# WP_TABLE_PREFIX=wp_
# LEGACY_SSH_HOST=172.16.1.2
# LEGACY_NAS_SCP=root@172.16.1.2:/mnt/main/apps/lawsonphotography-wp/wp-content/uploads
# LEGACY_EXPORT_ROOT=.legacy-export
# D1_TARGET=local

